# Configuracion de entorno para twitch-vod-auto
# Copia este archivo a .env y completa los valores

# ============================
# Twitch API (fuente primaria)
# ============================
TWITCH_CLIENT_ID=tu_client_id_de_twitch
TWITCH_CLIENT_SECRET=tu_client_secret_de_twitch

# ============================
# Proxy (opcional, para escala)
# ============================
# HTTP_PROXY=http://user:pass@proxy:8080
# HTTPS_PROXY=http://user:pass@proxy:8080

# ============================
# Dashboard
# ============================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# URL publica del dashboard, usada para renovar OAuth de YouTube desde el panel
# DASHBOARD_PUBLIC_URL=https://vod.privatevods.com
# Opcional si quieres fijar la callback exacta en Google Cloud Console
# YOUTUBE_OAUTH_REDIRECT_URI=https://vod.privatevods.com/api/youtube/oauth/callback

# ============================
# Logging JSON (para ELK/Loki)
# ============================
# JSON_LOGGING=true

# ============================
# Auth del dashboard (REQUERIDO en produccion)
# ============================
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# SECRET_KEY opcional: si no se define, se genera una aleatoria al arranque
# y las sesiones se invalidan al reiniciar. Para sesiones persistentes entre
# reinicios, define una clave fija (mínimo 32 chars random).
# SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria
