# Environment variables for twitch-vod-auto
# Copy this file to .env and fill in the values.

# ============================
# Twitch API
# ============================
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ============================
# Optional proxy
# ============================
# HTTP_PROXY=http://user:pass@proxy:8080
# HTTPS_PROXY=http://user:pass@proxy:8080

# ============================
# Dashboard
# ============================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Public dashboard URL used by the optional YouTube OAuth flow
# DASHBOARD_PUBLIC_URL=https://vod.privatevods.com
# Optional exact callback registered in Google Cloud Console
# YOUTUBE_OAUTH_REDIRECT_URI=https://vod.privatevods.com/api/youtube/oauth/callback

# ============================
# JSON logging for ELK or Loki
# ============================
# JSON_LOGGING=true

# ============================
# Windows development path to git-bash.exe for invoking twitch-dlp through npx
# ============================
# GIT_BASH_PATH=C:\Program Files\Git\git-bash.exe

# ============================
# Dashboard authentication
# ============================
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
# A random SECRET_KEY is generated when omitted, which invalidates sessions on
# restart. Set a fixed random value of at least 32 characters to keep sessions.
# SECRET_KEY=your-long-random-secret
