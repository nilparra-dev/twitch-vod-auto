{
  "manifest_version": 3,
  "name": "Twitch VOD Auto ID",
  "version": "1.1",
  "description": "Genera automáticamente el VOD ID en TwitchTracker o StreamsCharts",
  "permissions": ["scripting", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": [
        "*://twitchtracker.com/*",
        "*://streamscharts.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ]
}

